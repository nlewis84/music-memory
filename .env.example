# Optional: AdSense publisher id (defaults to ca-pub-7507779597055941)
REACT_APP_ADSENSE_CLIENT=

# Set true after AdSense approval + slot ids exist. Gates ad units only;
# the adsbygoogle.js script in public/index.html loads regardless.
REACT_APP_ADSENSE_ENABLED=false

# Ad unit ids from AdSense (Ads -> By ad unit)
REACT_APP_ADSENSE_SLOT_TOP=
REACT_APP_ADSENSE_SLOT_BOTTOM=

# Cat API key for celebration images
REACT_APP_CAT_API_KEY=
